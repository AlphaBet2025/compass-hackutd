# Copy this file to ".env" and fill in your keys. NEVER commit ".env".

# Google Gemini (free key at https://aistudio.google.com)
GEMINI_API_KEY=

# Capital One Nessie (https://api.nessieisreal.com)
NESSIE_API_KEY=

# Set to true to load the customer from Nessie instead of the built-in fake data
USE_NESSIE=false

# Port for the small API server
PORT=3001
